# Copy to .env (git-ignored) and adjust. Real environment variables override .env.

# Ingestion limits
INGESTION_ALLOWED_EXTENSIONS=.pdf,.txt,.md
INGESTION_MAX_FILE_SIZE_MB=25
INGESTION_MAX_FILES_PER_BATCH=20
# allow | block_exact | version
INGESTION_DUPLICATE_POLICY=allow

# Knowledge bases an upload may target (comma-separated, case-insensitive).
# it_policies: public university IT policies; hw_datasheets: public hardware
# datasheets (docs/SPEC.md, section 2). Topics pending PM confirmation.
INGESTION_ALLOWED_KB_IDS=it_policies,hw_datasheets

# Fixed-size baseline chunker. Measured in characters, not tokens, because no
# tokenizer is chosen yet. Overlap must be >= 0 and < size; an invalid overlap
# falls back to size // 5 and logs a warning.
INGESTION_CHUNK_SIZE_CHARS=1000
INGESTION_CHUNK_OVERLAP_CHARS=200

# Retrieval (F3): hits per ranked list (vector and keyword), per KB. POST /search
# can override it per request (1-100).
RETRIEVAL_TOP_K=20

# LLM (F4). The provider is chosen here; gemini is the only one so far. Set your
# key from https://aistudio.google.com/apikey (free tier). Without it the app
# still starts, but POST /ask returns 500 "GEMINI_API_KEY is not set".
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# Retries after a 429 (rate limit) or 503 (overloaded), backing off 2, 4, 8 s,
# before /ask returns 503 llm_unavailable.
LLM_MAX_RETRIES=3
# KB display names and descriptions (router input, /kbs). Every configured KB
# needs an entry, or the app refuses to start. Default: config/kb_descriptions.json
KB_DESCRIPTIONS_PATH=
