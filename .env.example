# Copy to .env (git-ignored) and adjust. Real environment variables override .env.

# Ingestion limits
INGESTION_ALLOWED_EXTENSIONS=.pdf,.txt,.md
INGESTION_MAX_FILE_SIZE_MB=25
INGESTION_MAX_FILES_PER_BATCH=20
# allow | block_exact | version
INGESTION_DUPLICATE_POLICY=allow

# Knowledge bases an upload may target (comma-separated, case-insensitive).
# Placeholders until KB topics are decided; see docs/decisions.md.
INGESTION_ALLOWED_KB_IDS=kb_placeholder_a,kb_placeholder_b
